{
  "name": "libreria-componentes-accesibles",
  "version": "0.1.0",
  "description": "Librería de componentes web accesibles (WCAG 2.2 AA) construidos con HTML, CSS y JavaScript nativos, cada componente independiente y sin dependencias de framework.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "node scripts/build-components.mjs && node scripts/copy-assets.mjs",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "html-validate \"src/**/*.html\"",
    "format": "prettier --write .",
    "check": "npm run lint && npm run lint:css && npm run test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.1",
    "@storybook/addon-a11y": "^8.5.0",
    "@storybook/addon-essentials": "^8.5.0",
    "@storybook/html-vite": "^8.5.0",
    "@testing-library/dom": "^10.4.0",
    "eslint": "^9.18.0",
    "eslint-plugin-storybook": "^0.11.2",
    "globals": "^15.14.0",
    "html-validate": "^8.24.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "storybook": "^8.5.0",
    "stylelint": "^16.13.2",
    "stylelint-config-standard": "^36.0.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
