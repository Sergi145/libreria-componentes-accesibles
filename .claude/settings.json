{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format-on-write.mjs",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node .claude/hooks/contrast-audit-reminder.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
